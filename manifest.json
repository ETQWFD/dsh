{
  "manifest_version": 3,
  "name": "DSH Harness - AI全能驾驭插件",
  "version": "2.0.0",
  "description": "给DeepSeek装上眼睛、双手和大脑：自动解析视频图片、自主搜索、AI绘画/视频生成、电脑操控、情感意识、游戏助手",
  "author": "ET",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.bilibili.com/*",
    "https://*.youtube.com/*",
    "https://*.douyin.com/*",
    "https://*.tiktok.com/*",
    "https://*.v.qq.com/*",
    "https://*.youku.com/*",
    "https://*.iqiyi.com/*",
    "https://*.baidu.com/*",
    "https://*.google.com/*",
    "https://api.openai.com/*",
    "https://*.unsplash.com/*",
    "https://image.pollinations.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
