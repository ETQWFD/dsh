{
  "manifest_version": 3,
  "name": "DSH Harness - AI全能驾驭插件",
  "version": "3.0.0",
  "description": "MC大师+喵语模式+Bing搜索+B站视频解析+AI绘画+壁纸系统，给DeepSeek装上眼睛双手和大脑",
  "author": "ET",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.bilibili.com/*",
    "https://*.youtube.com/*",
    "https://*.douyin.com/*",
    "https://*.bing.com/*",
    "https://image.pollinations.ai/*",
    "https://*.unsplash.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  }
}
